{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "stackping",
  "version": "0.1.0",
  "description": "Self-hosted Slack notifications for Graphite stacks, running in your own Cloudflare account",
  "keywords": [
    "alchemy",
    "cloudflare-workers",
    "durable-objects",
    "graphite",
    "pull-requests",
    "slack"
  ],
  "homepage": "https://github.com/dan-myles/stackping#readme",
  "bugs": "https://github.com/dan-myles/stackping/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan-myles/stackping.git"
  },
  "bin": {
    "stackping": "./bin/stackping.ts"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "lint": "oxlint .",
    "ck": "bun run typecheck && bun run test && bun run format && bun run lint",
    "dev": "alchemy dev --stage dev",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.4",
    "@effect/platform-node": "4.0.4",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/bun": "1.3.11",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "bun@1.3.11"
}
